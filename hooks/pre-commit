#!/bin/sh

CLANG_FORMAT="clang-format"

# Check whether clang-format is available.
if ! command -v clang-format >/dev/null 2>&1; then
    echo "clang-format not found in PATH"
    echo "Install LLVM/Clang or add it to PATH"
    exit 1
fi

FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h|hpp|cxx)$')

if [ -z "$FILES" ]; then
    exit 0
fi

echo "Running clang-format..."

for file in $FILES
do
    "$CLANG_FORMAT" -i "$file"
    git add "$file"
done

exit 0